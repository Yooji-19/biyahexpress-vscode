<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport"><meta content="mobile_tab" name="shell-type"><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"><link href="https://fonts.googleapis.com" rel="preconnect"><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;family=Plus+Jakarta+Sans:wght@600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { colors: { "on-tertiary": "#ffffff", "on-primary-container": "#95bcff", "secondary-fixed": "#d4e3ff", "error-container": "#ffdad6", "surface": "#f8f9ff", "on-secondary-fixed-variant": "#004786", "inverse-primary": "#a9c7ff", "on-background": "#061d30", "tertiary-fixed": "#eddcff", "on-secondary-fixed": "#001c3a", "surface-container-highest": "#d0e4ff", "primary-fixed-dim": "#a9c7ff", "tertiary": "#451a7d", "primary": "#00346a", "surface-container-low": "#eef4ff", "inverse-on-surface": "#e9f1ff", "surface-container-lowest": "#ffffff", "on-error-container": "#93000a", "on-secondary": "#ffffff", "outline-variant": "#c2c6d2", "on-tertiary-fixed": "#280056", "primary-container": "#064a91", "on-primary-fixed": "#001b3d", "inverse-surface": "#1e3246", "error": "#ba1a1a", "surface-bright": "#f8f9ff", "on-error": "#ffffff", "on-primary-fixed-variant": "#00468b", "primary-fixed": "#d6e3ff", "on-tertiary-container": "#cdacff", "tertiary-fixed-dim": "#d7baff", "surface-container-high": "#daeaff", "tertiary-container": "#5c3595", "on-surface": "#061d30", "surface-dim": "#c7dcf7", "on-primary": "#ffffff", "on-tertiary-fixed-variant": "#583090", "surface-container": "#e4efff", "surface-variant": "#d0e4ff", "on-secondary-container": "#003567", "on-surface-variant": "#424751", "outline": "#737782", "secondary-fixed-dim": "#a5c8ff", "background": "#f8f9ff", "secondary": "#005faf", "secondary-container": "#54a0fe", "surface-tint": "#295ea6" }, borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" }, spacing: { "margin": "1rem", "space-md": "1rem", "space-lg": "1.5rem", "margin-desktop": "2rem", "margin-tablet": "1.5rem", "gutter-mobile": "0.75rem", "space-xl": "2rem", "space-sm": "0.5rem", "gutter": "1rem", "space-xs": "0.25rem" }, fontFamily: { "headline-sm": ["Plus Jakarta Sans"], "label-sm": ["Plus Jakarta Sans"], "body-lg": ["Inter"], "headline-md": ["Plus Jakarta Sans"], "label-lg": ["Plus Jakarta Sans"], "body-md": ["Inter"], "label-md": ["Plus Jakarta Sans"], "body-strong": ["Inter"], "headline-lg-mobile": ["Plus Jakarta Sans"], "headline-lg": ["Plus Jakarta Sans"] }, fontSize: { "headline-sm": ["18px", { "lineHeight": "24px", "letterSpacing": "0", "fontWeight": "600" }], "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.04em", "fontWeight": "700" }], "body-lg": ["16px", { "lineHeight": "24px", "letterSpacing": "0.01em", "fontWeight": "400" }], "headline-md": ["22px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }], "label-lg": ["14px", { "lineHeight": "18px", "letterSpacing": "0.02em", "fontWeight": "700" }], "body-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "400" }], "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.03em", "fontWeight": "600" }], "body-strong": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }], "headline-lg-mobile": ["26px", { "lineHeight": "34px", "letterSpacing": "-0.01em", "fontWeight": "700" }], "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700" }] } } } }</script><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  
<style id="fixed-biyahexpress-header">
  .app-header {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 64px !important;
    padding: 0 16px !important;
    background: #f8f9ff !important;
    display: flex !important;
    align-items: center !important;
    z-index: 100 !important;
    box-shadow: 0 1px 5px rgba(0,0,0,0.05);
  }

  .app-header .logo-icon {
    display: flex !important;
    align-items: center !important;
    width: 31px !important;
    height: 40px !important;
    overflow: hidden !important;
    flex-shrink: 0;
    cursor: pointer;
  }

  .app-header .logo-icon img {
    height: 40px !important;
    width: auto !important;
    max-width: none !important;
    max-height: none !important;
    flex-shrink: 0;
  }

  .app-header .logo-icon:focus-visible {
    outline: 3px solid #295ea6;
    outline-offset: 4px;
  }

  body {
    padding-top: 64px !important;
  }

  body > main {
    padding-top: 16px !important;
  }
</style>

</head><body class="bg-surface font-body-md text-on-surface flex flex-col min-h-screen">
<header class="app-header">
  <a
    href="/pages/map.html"
    class="logo-icon"
    aria-label="Return to Accessibility Map"
    title="Back to Map"
  >
    <img
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuBpt6VD6taaf8BllkliQ4wCRtIlg8m3K6_LA0paWwaTO3_YMCEfmQFTYZpDAsavNExqLfLKz_zJr3l-EWOiLf8PxypBh5vaw894L6Z93H1FK4DqaGhEzLCUVbgllEmmRtwzEyYxB3TZ-ODD36leP-IKsUEgEkTJ78T3JODT4_VdkM44Z35rfCD83s_RfVdJZYw5A5hGThuZbcVnGaS_ofX5SUeaP2LgONrgj7YcVeZlcAuiDlXTufQ1mb98iBl9cb57L00"
      alt="BiyahExpress Logo"
    >
  </a>
</header>
<main class="flex-1 w-full bg-surface pb-24 pt-safe" style="padding-top: calc(env(safe-area-inset-top, 0px) + 5.5rem);"><div class="flex flex-col w-full px-space-md space-y-space-lg">
<!-- Top Hero Greeting & Civic Pulse -->
<section class="flex flex-col space-y-space-sm pt-space-xs mt-space-md pt-2">
<div class="flex items-center justify-between">
<div class="flex flex-col min-w-0">
<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface tracking-tight">Good morning, Commuter!</h1>
<p class="font-body-md text-body-md text-on-surface-variant flex items-center gap-space-xs">
<span class="inline-block w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
          Accessible transit ready • Metro Manila
        </p>
</div>
<button aria-label="Audio transit announcements" class="flex items-center justify-center w-12 h-12 rounded-full bg-surface-container-high text-primary hover:bg-surface-container-highest transition-colors flex-shrink-0" onclick="toggleAudioBriefing(this)">
<span class="material-symbols-outlined text-[24px]">volume_up</span>
</button>
</div>
<!-- Real-time Pulse Pill -->
<div class="flex items-center gap-space-xs bg-surface-container px-space-sm py-space-xs rounded-full w-fit shadow-sm">
<span class="material-symbols-outlined text-secondary text-[18px]">elevator</span>
<span class="font-label-md text-label-md text-on-surface">98% LRT-1 Elevators Operational</span>
<span class="w-1.5 h-1.5 rounded-full bg-secondary ml-1"></span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Live Sync</span>
</div>
</section>
<!-- Quick Accessible Search Bar -->
<section class="w-full">
<div class="relative flex items-center bg-surface-container-lowest rounded-xl shadow-md p-space-xs">
<div class="w-12 h-12 flex items-center justify-center text-primary flex-shrink-0">
<span class="material-symbols-outlined text-[24px]">search</span>
</div>
<input aria-label="Search destination" class="w-full bg-transparent font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none pr-space-xs" placeholder="Where are you heading today? (e.g. MRT Ayala, PGH Manila)" type="text">
<button aria-label="Voice search" class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container text-primary hover:bg-surface-container-high transition-colors flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">mic</span>
</button>
</div>
</section>
<!-- Visual Feature Cards Grid (2x2) -->
<section class="grid grid-cols-2 gap-gutter-mobile">
<!-- Card 1: Navigate -->
<div class="flex flex-col justify-between p-space-md rounded-2xl bg-[#EBF3FF] shadow-sm hover:shadow-md transition-all active:scale-[0.98] min-h-[160px] cursor-pointer" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-sm">
<span class="material-symbols-outlined text-[26px]">near_me</span>
</div>
<span class="material-symbols-outlined text-[#064A91] text-[20px] opacity-70">arrow_forward</span>
</div>
<div class="flex flex-col mt-space-md">
<span class="font-headline-sm text-headline-sm text-[#064A91]">Navigate</span>
<div class="mt-space-xs inline-flex items-center gap-1 bg-surface-container-lowest/80 px-2 py-0.5 rounded-full w-fit">
<span class="material-symbols-outlined text-[13px] text-[#064A91]">accessible</span>
<span class="font-label-sm text-label-sm text-[#064A91]">PWD Routing</span>
</div>
</div>
</div>
<!-- Card 2: Transit Info -->
<div class="flex flex-col justify-between p-space-md rounded-2xl bg-[#EAF8F0] shadow-sm hover:shadow-md transition-all active:scale-[0.98] min-h-[160px] cursor-pointer" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="w-12 h-12 rounded-xl bg-[#27AE60] flex items-center justify-center text-on-primary shadow-sm">
<span class="material-symbols-outlined text-[26px]">directions_subway</span>
</div>
<span class="material-symbols-outlined text-[#27AE60] text-[20px] opacity-70">arrow_forward</span>
</div>
<div class="flex flex-col mt-space-md">
<span class="font-headline-sm text-headline-sm text-[#1B6F3E]">Transit Info</span>
<div class="mt-space-xs inline-flex items-center gap-1 bg-surface-container-lowest/80 px-2 py-0.5 rounded-full w-fit">
<span class="material-symbols-outlined text-[13px] text-[#1B6F3E]">commute</span>
<span class="font-label-sm text-label-sm text-[#1B6F3E]">LRT, MRT, Bus</span>
</div>
</div>
</div>
<!-- Card 3: Report Hazard -->
<div class="flex flex-col justify-between p-space-md rounded-2xl bg-[#FEF5EC] shadow-sm hover:shadow-md transition-all active:scale-[0.98] min-h-[160px] cursor-pointer" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="w-12 h-12 rounded-xl bg-[#F2994A] flex items-center justify-center text-on-primary shadow-sm">
<span class="material-symbols-outlined text-[26px]">warning</span>
</div>
<span class="material-symbols-outlined text-[#F2994A] text-[20px] opacity-70">arrow_forward</span>
</div>
<div class="flex flex-col mt-space-md">
<span class="font-headline-sm text-headline-sm text-[#874A12]">Report Hazard</span>
<div class="mt-space-xs inline-flex items-center gap-1 bg-surface-container-lowest/80 px-2 py-0.5 rounded-full w-fit">
<span class="material-symbols-outlined text-[13px] text-[#874A12]">campaign</span>
<span class="font-label-sm text-label-sm text-[#874A12]">Crowdsourced</span>
</div>
</div>
</div>
<!-- Card 4: View Map -->
<div class="flex flex-col justify-between p-space-md rounded-2xl bg-[#F4EFFE] shadow-sm hover:shadow-md transition-all active:scale-[0.98] min-h-[160px] cursor-pointer" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="w-12 h-12 rounded-xl bg-tertiary flex items-center justify-center text-on-tertiary shadow-sm">
<span class="material-symbols-outlined text-[26px]">layers</span>
</div>
<span class="material-symbols-outlined text-tertiary text-[20px] opacity-70">arrow_forward</span>
</div>
<div class="flex flex-col mt-space-md">
<span class="font-headline-sm text-headline-sm text-tertiary">View Map</span>
<div class="mt-space-xs inline-flex items-center gap-1 bg-surface-container-lowest/80 px-2 py-0.5 rounded-full w-fit">
<span class="material-symbols-outlined text-[13px] text-tertiary">heat_pump</span>
<span class="font-label-sm text-label-sm text-tertiary">Spatial Grid</span>
</div>
</div>
</div>
</section>
<!-- Live Accessibility Alerts -->
<section class="flex flex-col space-y-space-sm">
<div class="flex items-center justify-between">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-error text-[22px]">notifications_active</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Live Accessibility Alerts</h2>
</div>
<span class="font-label-sm text-label-sm text-primary uppercase cursor-pointer hover:underline">2 Active</span>
</div>
<!-- Alert Card 1 (Maintenance Alert) -->
<div class="flex flex-col p-space-md rounded-xl bg-error-container text-on-error-container shadow-sm space-y-space-xs relative overflow-hidden">
<div class="flex items-start gap-space-sm">
<div class="w-8 h-8 rounded-full bg-error flex items-center justify-center text-on-error flex-shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">build</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between mb-1">
<span class="font-label-md text-label-md uppercase tracking-wide text-error font-bold">LRT-1 Doroteo Jose Station</span>
<span class="font-label-sm text-label-sm opacity-80">6m ago</span>
</div>
<p class="font-body-md text-body-md leading-snug">South Elevator under maintenance. Shuttle ramp assistance active at Ground Entrance 2.</p>
<div class="flex items-center gap-space-sm mt-space-sm">
<span class="inline-flex items-center gap-1 font-label-sm text-label-sm bg-surface-container-lowest/80 text-on-error-container px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[14px]">accessible_forward</span>
              Marshall On-Duty
            </span>
<span class="font-label-sm text-label-sm underline cursor-pointer">View bypass route</span>
</div>
</div>
</div>
</div>
<!-- Alert Card 2 (Infrastructure Alert) -->
<div class="flex flex-col p-space-md rounded-xl bg-surface-container-high text-on-surface shadow-sm space-y-space-xs relative overflow-hidden">
<div class="flex items-start gap-space-sm">
<div class="w-8 h-8 rounded-full bg-[#F2994A] flex items-center justify-center text-on-primary flex-shrink-0 mt-0.5">
<span class="material-symbols-outlined text-[18px]">construction</span>
</div>
<div class="flex-1 min-w-0">
<div class="flex items-center justify-between mb-1">
<span class="font-label-md text-label-md uppercase tracking-wide text-[#874A12] font-bold">Taft Ave. cor. Pedro Gil</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">18m ago</span>
</div>
<p class="font-body-md text-body-md text-on-surface leading-snug">Sidewalk repaving works. Temporary low-incline PWD wooden ramp installed on east curb.</p>
<div class="flex items-center gap-space-sm mt-space-sm">
<span class="inline-flex items-center gap-1 font-label-sm text-label-sm bg-surface-container-lowest text-on-surface px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[14px] text-secondary">verified</span>
              14 Community Confirmations
            </span>
</div>
</div>
</div>
</div>
</section>
<!-- Community Transit Snapshot & Commute Stats -->
<section class="bg-surface-container-low rounded-2xl p-space-md shadow-sm flex flex-col space-y-space-md">
<div class="flex items-center justify-between">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Metro Mobility Index</span>
<span class="font-headline-sm text-headline-sm text-primary">High Accessibility</span>
</div>
<div class="flex items-center gap-1 bg-surface-container-lowest px-2 py-1 rounded-full text-secondary font-label-md text-label-md">
<span class="material-symbols-outlined text-[16px]">verified_user</span>
        Clear Corridors
      </div>
</div>
<!-- Inline Mini Graph / Metric Flow -->
<div class="w-full flex items-end justify-between h-16 pt-2 px-1">
<div class="flex flex-col items-center gap-1 flex-1">
<div class="w-full mx-1 bg-surface-container-highest rounded-full h-8 flex items-end">
<div class="w-full bg-primary rounded-full h-6"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">MRT-3</span>
</div>
<div class="flex flex-col items-center gap-1 flex-1">
<div class="w-full mx-1 bg-surface-container-highest rounded-full h-12 flex items-end">
<div class="w-full bg-secondary rounded-full h-11"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">LRT-1</span>
</div>
<div class="flex flex-col items-center gap-1 flex-1">
<div class="w-full mx-1 bg-surface-container-highest rounded-full h-10 flex items-end">
<div class="w-full bg-tertiary-container rounded-full h-9"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">LRT-2</span>
</div>
<div class="flex flex-col items-center gap-1 flex-1">
<div class="w-full mx-1 bg-surface-container-highest rounded-full h-14 flex items-end">
<div class="w-full bg-primary-container rounded-full h-13"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">EDSA Bus</span>
</div>
<div class="flex flex-col items-center gap-1 flex-1">
<div class="w-full mx-1 bg-surface-container-highest rounded-full h-9 flex items-end">
<div class="w-full bg-secondary-container rounded-full h-7"></div>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant">Jeepney</span>
</div>
</div>
</section>
<!-- Recent Routes -->
<section class="flex flex-col space-y-space-sm pb-space-lg">
<div class="flex items-center justify-between">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[22px]">history</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface">Recent Routes</h2>
</div>
<button class="font-label-sm text-label-sm text-primary uppercase hover:underline">View All</button>
</div>
<!-- Route 1 -->
<div class="flex flex-col bg-surface-container-lowest p-space-md rounded-xl shadow-sm hover:shadow-md transition-all active:bg-surface-container-low cursor-pointer space-y-space-xs" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="flex items-center gap-space-sm min-w-0">
<div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-on-primary-fixed flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">directions_bus</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-body-strong text-body-strong text-on-surface truncate">EDSA Carousel Guadalupe → BGC High Street</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">4.2 km • 22 min commute</span>
</div>
</div>
<span class="material-symbols-outlined text-outline text-[20px]">chevron_right</span>
</div>
<div class="flex items-center gap-space-xs pt-1 flex-wrap">
<span class="inline-flex items-center gap-1 bg-[#E8F8EE] text-[#27AE60] font-label-sm text-label-sm px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[13px]">accessible</span>
          Fully Accessible
        </span>
<span class="inline-flex items-center gap-1 bg-surface-container text-on-surface-variant font-label-sm text-label-sm px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[13px]">elevator</span>
          Elevators Working
        </span>
</div>
</div>
<!-- Route 2 -->
<div class="flex flex-col bg-surface-container-lowest p-space-md rounded-xl shadow-sm hover:shadow-md transition-all active:bg-surface-container-low cursor-pointer space-y-space-xs" role="button" tabindex="0">
<div class="flex items-start justify-between">
<div class="flex items-center gap-space-sm min-w-0">
<div class="w-10 h-10 rounded-xl bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed flex-shrink-0">
<span class="material-symbols-outlined text-[20px]">blind</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-body-strong text-body-strong text-on-surface truncate">DLSU Taft Avenue → Philippine General Hospital</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">1.8 km • 14 min commute</span>
</div>
</div>
<span class="material-symbols-outlined text-outline text-[20px]">chevron_right</span>
</div>
<div class="flex items-center gap-space-xs pt-1 flex-wrap">
<span class="inline-flex items-center gap-1 bg-[#F3EDFC] text-[#7952B3] font-label-sm text-label-sm px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[13px]">touch_app</span>
          Tactile Guided
        </span>
<span class="inline-flex items-center gap-1 bg-surface-container text-on-surface-variant font-label-sm text-label-sm px-2 py-0.5 rounded-full">
<span class="material-symbols-outlined text-[13px]">record_voice_over</span>
          Audio Crosswalks
        </span>
</div>
</div>
</section>
</div>
<script>
  // Ensure the Home navigation item is highlighted
  (function() {
    const navItems = document.querySelectorAll('nav a');
    navItems.forEach(item => {
      const path = item.getAttribute('data-path');
      const pill = item.querySelector('.nav-pill');
      const label = item.querySelector('.nav-label');
      
      if (path === 'dashboard' || item.textContent.trim().toLowerCase().includes('home')) {
        pill.classList.remove('text-on-surface-variant');
        pill.classList.add('bg-primary-container', 'text-on-primary');
        label.classList.remove('text-on-surface-variant');
        label.classList.add('text-primary-container', 'font-headline-sm');
      } else {
        pill.classList.remove('bg-primary-container', 'text-on-primary');
        pill.classList.add('text-on-surface-variant');
        label.classList.remove('text-primary-container', 'font-headline-sm');
        label.classList.add('text-on-surface-variant');
      }
    });
  })();

  function toggleAudioBriefing(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon.textContent === 'volume_up') {
      icon.textContent = 'record_voice_over';
      btn.classList.add('bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container-high', 'text-primary');
      if ('speechSynthesis' in window) {
        const speech = new SpeechSynthesisUtterance("Welcome to BiyahExpress. 98 percent of LRT-1 elevators are active. Watch out for maintenance at Doroteo Jose Station.");
        speech.rate = 1;
        window.speechSynthesis.speak(speech);
        speech.onend = () => {
          icon.textContent = 'volume_up';
          btn.classList.remove('bg-primary', 'text-on-primary');
          btn.classList.add('bg-surface-container-high', 'text-primary');
        };
      }
    } else {
      window.speechSynthesis.cancel();
      icon.textContent = 'volume_up';
      btn.classList.remove('bg-primary', 'text-on-primary');
      btn.classList.add('bg-surface-container-high', 'text-primary');
    }
  }
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]" data-active-classes="[&amp;_.nav-pill]:bg-primary-container [&amp;_.nav-pill]:text-on-primary [&amp;_.nav-label]:text-primary-container [&amp;_.nav-label]:font-headline-sm"><div class="flex justify-around items-center h-20 px-space-xs"><a class="flex flex-col items-center justify-center w-20 min-h-[48px] py-space-xs group transition-colors text-on-surface-variant hover:text-on-surface" data-path="spatial-map" href="#"><div class="nav-pill w-16 h-8 flex items-center justify-center rounded-full transition-all text-on-surface-variant"><span class="material-symbols-outlined text-[24px]">explore</span></div><span class="nav-label font-label-sm text-label-sm transition-all mt-space-xs text-on-surface-variant">Map</span></a><a class="flex flex-col items-center justify-center w-20 min-h-[48px] py-space-xs group transition-colors text-on-surface-variant hover:text-on-surface" data-path="hazard-reports" href="#"><div class="nav-pill w-16 h-8 flex items-center justify-center rounded-full transition-all text-on-surface-variant"><span class="material-symbols-outlined text-[24px]">security</span></div><span class="nav-label font-label-sm text-label-sm transition-all mt-space-xs text-on-surface-variant">Reports</span></a><a class="flex flex-col items-center justify-center w-20 min-h-[48px] py-space-xs group transition-colors text-on-surface-variant hover:text-on-surface" data-path="user-profile" href="#"><div class="nav-pill w-16 h-8 flex items-center justify-center rounded-full transition-all text-on-surface-variant"><span class="material-symbols-outlined text-[24px]">account_circle</span></div><span class="nav-label font-label-sm text-label-sm transition-all mt-space-xs text-on-surface-variant">More</span></a></div>
